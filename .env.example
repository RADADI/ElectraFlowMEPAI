# ─── Rename this file to .env and fill in your values ────────────────────────
# The app works without any keys — it uses mock/dummy data by default.

# ─── Clerk Authentication (optional) ─────────────────────────────────────────
# If absent, the app uses localStorage-based mock authentication.
# 1. Create a free account at https://clerk.com
# 2. Create a new application
# 3. Copy your Publishable Key from Clerk Dashboard → API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Supabase Backend (Phase 3 — optional) ───────────────────────────────────
# If absent, the app uses dummy-data.ts for all data. No crash, no errors.
# 1. Create a free Supabase project at https://supabase.com
# 2. Go to Project Settings → API
# 3. Copy Project URL and anon/public key below
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxx
